# OpenVPN — username/password auth example.
#
# .ovpn and .conf are the same format; the extension is purely convention.
# Inline blocks <ca>, <tls-auth>, <cert>, <key> embed PEM/key material
# directly in the file instead of referencing external paths.
#
# This file is illustrative — the placeholder CA and tls-auth blocks are
# not real keys, so NetworkManager will reject it on import. Drop in the
# blocks from your provider's generated config to make it functional.

client
dev tun
remote-random

remote vpn-1.example.com 1194
remote vpn-2.example.com 1194
proto udp

resolv-retry infinite
nobind
persist-key
persist-tun

cipher CHACHA20-POLY1305
data-ciphers CHACHA20-POLY1305:AES-256-GCM:AES-128-GCM
auth-user-pass
key-direction 1
verb 3

<ca>
-----BEGIN CERTIFICATE-----
PLACEHOLDER_CA_CERTIFICATE_BASE64_REPLACE_WITH_PROVIDER_CA
-----END CERTIFICATE-----
</ca>

<tls-auth>
-----BEGIN OpenVPN Static key V1-----
PLACEHOLDER_TLS_AUTH_STATIC_KEY_REPLACE_WITH_PROVIDER_STATIC_KEY
-----END OpenVPN Static key V1-----
</tls-auth>
